{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Nest",
  "version": "0.1.5",
  "identifier": "com.local.servernest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Server Nest",
      "width": 1120,
      "height": 720,
      "minWidth": 880,
      "minHeight": 600,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMDVGRjIwOEQ3NDk0ODIKUldTQ2xIU05JUDhGK3pnUVdCSCsyczBHQzNPRWlZUkI0S1VwVnlMRzJNZ1F2T0Q5NnFKL28vR1gK",
      "endpoints": ["https://github.com/jason2071/manage-server-local/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
